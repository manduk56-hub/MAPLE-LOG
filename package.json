{
  "name": "maplelog",
  "version": "0.1.3",
  "private": true,
  "description": "캐릭터와 파티의 보스 모험을 기록하는 메이플스토리 일기장",
  "author": "Maplelog",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node server.cjs",
    "start": "electron .",
    "check": "node --check app.js && node --check backup.js && node --check pagination.js && node --check expense-model.js && node --check expense.js && node --check server.cjs && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check content.js && node scripts/build-content.cjs --check",
    "build": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --win --dir --x64",
    "content:build": "node scripts/build-content.cjs",
    "predev": "npm run content:build",
    "prestart": "npm run content:build",
    "prebuild": "npm run content:build",
    "prebuild:dir": "npm run content:build"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.maplelog.diary",
    "productName": "메이플로그",
    "asarUnpack": [
      "desktop/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "maple-theme.css",
      "game-theme.css",
      "app.js",
      "backup.js",
      "pagination.js",
      "expense-model.js",
      "expense.js",
      "diary-ui.css",
      "desktop/**",
      "assets/**",
      "package.json",
      "content.js",
      "content/**"
    ],
    "win": {
      "icon": "assets/maplelog-icon.ico",
      "target": "nsis",
      "signExecutable": false,
      "artifactName": "Maplelog-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "메이플로그",
      "deleteAppDataOnUninstall": false
    }
  }
}
